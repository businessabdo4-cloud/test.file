 "beats": [
  {
   "beat": 1,
   "start": 0.07,
   "end": 3.92,
   "text": "Arrêtez de poster vos projets sur les réseaux sociaux… si c’est pour que personne ne les voie."
  },
  {
   "beat": 2,
   "start": 4.72,
   "end": 9.0,
   "text": "Designers d’intérieur, vos futurs clients vous cherchent en ligne avant même de vous appeler."
  },
  {
   "beat": 3,
   "start": 9.67,
   "end": 17.27,
   "text": "Chez ROIA MEDIA, on gère vos réseaux sociaux de A à Z : stratégie, création de contenu, publication, et réponses à votre communauté."
  },
  {
   "beat": 4,
   "start": 18.07,
   "end": 20.91,
   "text": "Vous créez de beaux intérieurs. Nous, on les fait voir."
  },
  {
   "beat": 5,
   "start": 21.47,
   "end": 23.91,
   "text": "Envoyez-nous « CM » en message pour en parler !"
  }
 ],
